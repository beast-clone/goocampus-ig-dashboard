# GooCampus Dashboard — env template
# Copy this to .env.local for local dev; paste these keys into Netlify env vars for production.

# --- Login ---
DASHBOARD_PASSWORD=                   # any strong string
SESSION_SECRET=                       # 64+ random hex chars (node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")

# --- Meta App (GooCampus Analytics, App ID 1325868559684543) ---
META_APP_ID=1325868559684543
META_APP_SECRET=                      # https://developers.facebook.com/apps/1325868559684543/settings/basic/
META_LONG_LIVED_USER_TOKEN=           # Graph API Explorer → exchange short→long via /oauth/access_token; expires every 60 days

# --- Meta Ads (primary ad account) ---
META_AD_ACCOUNT_ID=act_490085459361407
META_AD_ACCOUNT_NAME=GooCampus Edu

# --- Single-account env fallback (only used if no accounts.local.json AND no ACCOUNTS_JSON) ---
IG_PAGE_ID=
IG_PAGE_NAME=
IG_PAGE_ACCESS_TOKEN=
IG_USER_ID=
IG_USERNAME=

# --- Production: ALL 5 accounts as inline JSON ---
# Paste the entire array from accounts.local.json as one line.
# Used by lib/instagram.ts when accounts.local.json isn't on disk (e.g. Netlify).
ACCOUNTS_JSON=

# --- Airtable (marketing hub base) ---
AIRTABLE_API_KEY=                     # pat... token from https://airtable.com/create/tokens
AIRTABLE_BASE_ID=appLdJFTrothBLDc0
AIRTABLE_TABLE_COMPETITOR_ADS=IG_Competitor_Ads

# --- Apify (FB Ad Library scraper) ---
APIFY_API_TOKEN=                      # apify_api_... from https://console.apify.com/account/integrations

# --- AI Reports button (optional; pick one provider) ---
ANTHROPIC_API_KEY=
# PERPLEXITY_API_KEY=
# OPENAI_API_KEY=

# --- LinkedIn (Community Management API — GC World Pages API app) ---
LINKEDIN_CLIENT_ID=86a1luhoymqmmy
LINKEDIN_CLIENT_SECRET=                # app Auth tab → Primary Client Secret (needed only for token refresh)
LINKEDIN_ACCESS_TOKEN=                 # 2-month member token, scopes r_organization_social + r_organization_followers + rw_organization_admin
LINKEDIN_REFRESH_TOKEN=               # 1-year refresh token
LINKEDIN_ORG_URN_GCWORLD=             # optional — auto-discovered from the token if left blank

# --- YouTube (YouTube Analytics API) ---
YOUTUBE_CLIENT_ID=              # Google Cloud OAuth client id
YOUTUBE_CLIENT_SECRET=          # OAuth client secret
YOUTUBE_ACCESS_TOKEN=           # scope yt-analytics.readonly (+ youtube.readonly)
YOUTUBE_REFRESH_TOKEN=          # refresh token (access tokens last ~1h)
YOUTUBE_CHANNEL_IDS=            # JSON map { "goocampus": "UCxxxx", ... }
